{
  "name": "@tenderflow/api",
  "version": "1.0.0-rc2",
  "description": "TenderFlow API service (REST API + static web host)",
  "main": "./dist/server.js",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "mammoth": "^1.9.0",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "unpdf": "^0.12.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": { "node": ">=20" }
}
