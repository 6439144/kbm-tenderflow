# TenderFlow v1 — environment (docs/BUILD-SPEC.md §4)
# Copy to .env at the repo root and fill in. Never commit real values.
# Generate BID_MASTER_KEY / AUDIT_SIGNING_KEY with: npm run gen-keys

PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
DATA_DIR=./data

# Optional: external PostgreSQL. Empty → embedded PGlite persisted at DATA_DIR/pg
DATABASE_URL=

# Optional: RS256 private key (PEM, \n-escaped allowed). Empty → generated once and stored in the DB
JWT_PRIVATE_KEY_PEM=

# Optional: also accept tokens from an external OIDC IdP (Keycloak / Entra / AD FS). Both required together.
EXTERNAL_OIDC_ISSUER=
EXTERNAL_OIDC_AUDIENCE=

# Required: base64 of exactly 32 random bytes (startup fails without it)
BID_MASTER_KEY=
# Required: HMAC key for the audit chain (startup fails without it)
AUDIT_SIGNING_KEY=

# Seed demo tenants/users/data on first start (only when the DB has no tenants)
SEED_DEMO=true
# Required when SEED_DEMO=true: password for every demo user
DEMO_PASSWORD=
# Presenter mode for live demos: persona switch + deadline control (/api/v1/demo/*). NEVER in production.
DEMO_MODE=true

# filesystem (DATA_DIR/content) | filenet
CONTENT_STORE_TYPE=filesystem
FILENET_GRAPHQL_URL=
FILENET_OBJECT_STORE=
FILENET_SERVICE_USER=
FILENET_SERVICE_PASSWORD=
FILENET_DOC_CLASS=Document
FILENET_ROOT_FOLDER=/TenderFlow
FILENET_SET_CUSTOM_PROPERTIES=false
# Addenda that supersede a document are checked in as its next MAJOR version (checkout + checkin).
# false = each version is a new FileNet document and TenderFlow keeps the chain. Enable only after
# `npm run verify:filenet` step 8 (versioning) passes live. See docs/filenet/SHOWCASE.md.
FILENET_VERSIONING=false
# Records declaration at award: none | property (TF_RecordDeclared, needs ACCE-RUNBOOK §1b) | retention
FILENET_RECORDS_MODE=none
# retention mode only: CmRetentionDate = award time + N days (ASSUMED, not verified live)
FILENET_RETENTION_DAYS=
# Document intelligence: write TF_DocType / TF_ExpiryDate / TF_AIReviewed on the stored document when a person accepts the
# extracted data (FileNet: needs FILENET_DOC_CLASS=TF_Document and the property templates of docs/filenet/ACCE-RUNBOOK.md §1c)
FILENET_AI_PROPERTIES=false
# Optional IBM Content Navigator deep links in the evidence panel (link format ASSUMED, see SHOWCASE.md)
FILENET_NAVIGATOR_URL=
FILENET_NAVIGATOR_DESKTOP=ICN
# Navigator repository id (defaults to FILENET_OBJECT_STORE)
FILENET_NAVIGATOR_REPOSITORY=

# AI (advisory). Missing → AI endpoints return 503 AI_NOT_CONFIGURED
WXO_INSTANCE_URL=
WXO_API_KEY=
WXO_IAM_URL=https://iam.cloud.ibm.com/identity/token
WXO_AGENT_PACK_CHECKER=
WXO_AGENT_CLARIFICATION=
WXO_AGENT_COMPLIANCE=
WXO_AGENT_REQUEST_CLASSIFIER=
WXO_AGENT_NOTICE_DRAFTER=
WXO_AGENT_RELEVANCE_MATCHER=
WXO_AGENT_EVALUATION_NARRATOR=
WXO_AGENT_GRADE_REVIEWER=
# Document intelligence (classify every uploaded document + extract cited data); empty = tenderflow_document_intelligence
WXO_AGENT_DOCUMENT_INTELLIGENCE=
# Supervisor copilot (collaborators = the nine agents above); empty = tenderflow_assistant
WXO_AGENT_ASSISTANT=
# Optional grade-review checklist JSON (see agents/README.md); empty = built-in list
WXO_GRADE_CRITERIA=

# Optional extras
# CORS_ORIGIN=http://localhost:5173      # only needed when the web app is served from another origin
# WEB_DIST_DIR=./apps/web/dist           # default: apps/web/dist
# LOGIN_RATE_LIMIT_PER_MIN=30
# CLOSE_JOB_INTERVAL_MS=60000
WXO_LLM=
WXO_TIMEOUT_MS=90000

# Document intelligence auto-run (when Orchestrate is configured). true: also classify vendor and request-letter uploads
# automatically (the entity setting in Admin → Document types wins); false: never automatic (manual "Classify with
# Orchestrate" only); empty: tender documents per cycle template, vendor/letter uploads per entity setting (default off).
# Sealed bids are only ever classified after their opening.
DOC_AI_AUTO=

# --- insight ---
# Public tender board (/tenders, /api/v1/public/tenders, .rss, .json): requests per minute per client IP.
# Each entity opts in/out with its "publicBoard" setting (Admin -> Entity settings; default on).
PUBLIC_BOARD_RATE_LIMIT_PER_MIN=60
# --- notify --- (docs/NOTIFICATIONS-AND-ESCALATION.md)
# In-app notifications always work. E-mail and SMS are only sent when configured here; otherwise each e-mail / SMS is
# recorded in the delivery log as SKIPPED_NOT_CONFIGURED (never "sent").
# E-mail over SMTP (enabled when SMTP_HOST and SMTP_FROM are set). SMTP_SECURE=true for implicit TLS (port 465);
# false uses STARTTLS when the server offers it (port 587 / 25).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP_TLS_REJECT_UNAUTHORIZED=true   # set false only for an internal relay with a self-signed certificate
# SMS through a generic HTTP adapter (enabled when SMS_HTTP_URL is set). Placeholders {to} {text} {sender} in the body.
SMS_HTTP_URL=
SMS_HTTP_METHOD=POST
# One header line, e.g. "Authorization: Bearer <token>" or "X-API-Key: <key>"
SMS_HTTP_AUTH_HEADER=
SMS_HTTP_CONTENT_TYPE=application/json
SMS_HTTP_BODY_TEMPLATE={"to":"{to}","from":"{sender}","text":"{text}"}
SMS_SENDER=
# Dotted path of the provider's message id in a JSON response, e.g. data.messageId
SMS_HTTP_MESSAGE_ID_PATH=
# SMS_HTTP_TIMEOUT_MS=15000
# Language of SMS texts and of the first half of bilingual e-mails (ar | en)
NOTIFY_DEFAULT_LANG=ar
# Background jobs (delivery retries, approval reminders / escalation). Admin → Background jobs shows them with "Run now".
SCHEDULER_ENABLED=true
NOTIFY_DELIVERY_JOB_MS=30000
NOTIFY_RETRY_BASE_MS=60000
NOTIFY_SEND_IMMEDIATELY=true
APPROVAL_ESCALATION_JOB_MS=300000
