# TenderFlow v1 — environment (docs/BUILD-SPEC.md §4)
# Copy to .env at the repo root and fill in. Never commit real values.
# Generate BID_MASTER_KEY / AUDIT_SIGNING_KEY with: npm run gen-keys

PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
DATA_DIR=./data

# Optional: external PostgreSQL. Empty → embedded PGlite persisted at DATA_DIR/pg
DATABASE_URL=

# Optional: RS256 private key (PEM, \n-escaped allowed). Empty → generated once and stored in the DB
JWT_PRIVATE_KEY_PEM=

# Optional: also accept tokens from an external OIDC IdP (Keycloak / Entra / AD FS). Both required together.
EXTERNAL_OIDC_ISSUER=
EXTERNAL_OIDC_AUDIENCE=

# Required: base64 of exactly 32 random bytes (startup fails without it)
BID_MASTER_KEY=
# Required: HMAC key for the audit chain (startup fails without it)
AUDIT_SIGNING_KEY=

# Seed demo tenants/users/data on first start (only when the DB has no tenants)
SEED_DEMO=true
# Required when SEED_DEMO=true: password for every demo user
DEMO_PASSWORD=
# Presenter mode for live demos: persona switch + deadline control (/api/v1/demo/*). NEVER in production.
DEMO_MODE=true

# filesystem (DATA_DIR/content) | filenet
CONTENT_STORE_TYPE=filesystem
FILENET_GRAPHQL_URL=
FILENET_OBJECT_STORE=
FILENET_SERVICE_USER=
FILENET_SERVICE_PASSWORD=
FILENET_DOC_CLASS=Document
FILENET_ROOT_FOLDER=/TenderFlow
FILENET_SET_CUSTOM_PROPERTIES=false
# Addenda that supersede a document are checked in as its next MAJOR version (checkout + checkin).
# false = each version is a new FileNet document and TenderFlow keeps the chain. Enable only after
# `npm run verify:filenet` step 8 (versioning) passes live. See docs/filenet/SHOWCASE.md.
FILENET_VERSIONING=false
# Records declaration at award: none | property (TF_RecordDeclared, needs ACCE-RUNBOOK §1b) | retention
FILENET_RECORDS_MODE=none
# retention mode only: CmRetentionDate = award time + N days (ASSUMED, not verified live)
FILENET_RETENTION_DAYS=
# Document intelligence: write TF_DocType / TF_ExpiryDate / TF_AIReviewed on the stored document when a person accepts the
# extracted data (FileNet: needs FILENET_DOC_CLASS=TF_Document and the property templates of docs/filenet/ACCE-RUNBOOK.md §1c)
FILENET_AI_PROPERTIES=false
# Class model: single = every document in FILENET_DOC_CLASS (rc3) | subclasses = TF_TenderDocument, TF_BidEnvelope,
# TF_VendorDocument, TF_CommitteeRecord, TF_EvidencePack under TF_Document (docs/filenet/ACCE-RUNBOOK.md §6).
# A class or property missing in the object store is never written: the upload falls back to FILENET_DOC_CLASS.
FILENET_CLASS_MODEL=single
# Document security: off = class default security | groups = permission list per confidentiality level, written at
# create; sealed envelopes go from SEALED (service user only) to COMMITTEE when the chair opens them (ACCE-RUNBOOK §7).
FILENET_ACL_MODE=off
# Directory groups (short name or DN) that get "view content" at each level; at least one with FILENET_ACL_MODE=groups.
FILENET_GROUP_PUBLIC=
FILENET_GROUP_INTERNAL=
# SEALED: normally empty (nobody but the service user until the opening)
FILENET_GROUP_SEALED=
FILENET_GROUP_COMMITTEE=
FILENET_GROUP_AUDIT=
# Grantee name of the service user if ACCE shows it differently (default FILENET_SERVICE_USER); always full control
FILENET_ACL_SERVICE_GRANTEE=
# How often failed permission changes are retried (job filenet-access-retry), in ms
FILENET_ACCESS_RETRY_MS=300000
# IBM Content Navigator for evidence links (bookmark format ASSUMED, see docs/filenet/SHOWCASE.md).
# Empty = found on the FileNet server (<origin>/navigator, then <origin>/icn/navigator); off = no Navigator links.
FILENET_NAVIGATOR_URL=
FILENET_NAVIGATOR_DESKTOP=ICN
# Navigator repository id (defaults to FILENET_OBJECT_STORE)
FILENET_NAVIGATOR_REPOSITORY=
# ACCE link in the evidence panel. Empty = <FileNet origin>/acce; off = no ACCE link.
FILENET_ACCE_URL=

# AI (advisory). Missing → AI endpoints return 503 AI_NOT_CONFIGURED
WXO_INSTANCE_URL=
WXO_API_KEY=
WXO_IAM_URL=https://iam.cloud.ibm.com/identity/token
WXO_AGENT_PACK_CHECKER=
WXO_AGENT_CLARIFICATION=
WXO_AGENT_COMPLIANCE=
WXO_AGENT_REQUEST_CLASSIFIER=
WXO_AGENT_NOTICE_DRAFTER=
WXO_AGENT_RELEVANCE_MATCHER=
WXO_AGENT_EVALUATION_NARRATOR=
WXO_AGENT_GRADE_REVIEWER=
# Document intelligence (classify every uploaded document + extract cited data); empty = tenderflow_document_intelligence
WXO_AGENT_DOCUMENT_INTELLIGENCE=
# Supervisor copilot (collaborators = the nine agents above); empty = tenderflow_assistant
WXO_AGENT_ASSISTANT=
# Optional grade-review checklist JSON (see agents/README.md); empty = built-in list
WXO_GRADE_CRITERIA=

# Optional extras
# CORS_ORIGIN=http://localhost:5173      # only needed when the web app is served from another origin
# WEB_DIST_DIR=./apps/web/dist           # default: apps/web/dist
# LOGIN_RATE_LIMIT_PER_MIN=30
# CLOSE_JOB_INTERVAL_MS=60000
WXO_LLM=
WXO_TIMEOUT_MS=90000

# Document intelligence auto-run (when Orchestrate is configured). true: also classify vendor and request-letter uploads
# automatically (the entity setting in Admin → Document types wins); false: never automatic (manual "Classify with
# Orchestrate" only); empty: tender documents per cycle template, vendor/letter uploads per entity setting (default off).
# Sealed bids are only ever classified after their opening.
DOC_AI_AUTO=

# --- insight ---
# Public tender board (/tenders, /api/v1/public/tenders, .rss, .json): requests per minute per client IP.
# Each entity opts in/out with its "publicBoard" setting (Admin -> Entity settings; default on).
PUBLIC_BOARD_RATE_LIMIT_PER_MIN=60
# --- notify --- (docs/NOTIFICATIONS-AND-ESCALATION.md)
# In-app notifications always work. E-mail and SMS are only sent when configured here; otherwise each e-mail / SMS is
# recorded in the delivery log as SKIPPED_NOT_CONFIGURED (never "sent").
# E-mail over SMTP (enabled when SMTP_HOST and SMTP_FROM are set). SMTP_SECURE=true for implicit TLS (port 465);
# false uses STARTTLS when the server offers it (port 587 / 25).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP_TLS_REJECT_UNAUTHORIZED=true   # set false only for an internal relay with a self-signed certificate
# SMS through a generic HTTP adapter (enabled when SMS_HTTP_URL is set). Placeholders {to} {text} {sender} in the body.
SMS_HTTP_URL=
SMS_HTTP_METHOD=POST
# One header line, e.g. "Authorization: Bearer <token>" or "X-API-Key: <key>"
SMS_HTTP_AUTH_HEADER=
SMS_HTTP_CONTENT_TYPE=application/json
SMS_HTTP_BODY_TEMPLATE={"to":"{to}","from":"{sender}","text":"{text}"}
SMS_SENDER=
# Dotted path of the provider's message id in a JSON response, e.g. data.messageId
SMS_HTTP_MESSAGE_ID_PATH=
# SMS_HTTP_TIMEOUT_MS=15000
# Language of SMS texts and of the first half of bilingual e-mails (ar | en)
NOTIFY_DEFAULT_LANG=ar
# Background jobs (delivery retries, approval reminders / escalation). Admin → Background jobs shows them with "Run now".
SCHEDULER_ENABLED=true
NOTIFY_DELIVERY_JOB_MS=30000
NOTIFY_RETRY_BASE_MS=60000
NOTIFY_SEND_IMMEDIATELY=true
APPROVAL_ESCALATION_JOB_MS=300000
# --- security ---
# Encryption key for TOTP (two-step verification) secrets at rest: base64 of exactly 32 bytes
# (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"). Unset → derived from AUDIT_SIGNING_KEY
# with HKDF. Changing/rotating it makes existing enrolments unreadable (users must be reset and enrol again).
MFA_ENC_KEY=
# Emergency switch: true = the staff network allowlist is NOT enforced (shown as a warning on Admin → Identity & access).
STAFF_NETWORK_BREAK_GLASS=false
# Allow a plain-http OIDC issuer that is not localhost (never in production).
OIDC_ALLOW_HTTP=false
# Staff SSO client secret(s): the admin page stores only the NAME of the variable (must start with TF_OIDC_SECRET_).
# TF_OIDC_SECRET_MOI=
# --- harden --- (docs/SECURITY-FEATURES.md §6)
# Sign-in lockout: this many failed password / second-factor attempts within the window lock the sign-in name for
# LOGIN_LOCKOUT_MINUTES (unknown usernames are treated the same way). 0 attempts = lockout off.
LOGIN_LOCKOUT_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_MIN=15
LOGIN_LOCKOUT_MINUTES=15
# Reverse proxy in front of the API: off (default) = X-Forwarded-For is ignored and req.ip is the TCP peer.
# Behind the OpenShift router use the hop count (1) or the router addresses / CIDRs. 'true' is refused.
TRUST_PROXY=false
# --- moi ---
# Vendor lifecycle jobs (block reinstatement, subscription expiry, NOT-001 reminders): interval in ms; 0 disables the timer.
LIFECYCLE_JOB_INTERVAL_MS=900000
# KNET: no integration yet (needs MOI's merchant + specification, DEP-004); subscription payments by KNET answer 503 KNET_NOT_CONFIGURED.
# --- ops --- (docs/INSTALLATION-AND-OPERATIONS.md; check everything with `npm run config:check`)
# development (default) | demo | test | production. production REFUSES TO START on: DEMO_MODE / SEED_DEMO on, DEMO_PASSWORD
# set, no DATABASE_URL (PGlite), missing/weak/placeholder BID_MASTER_KEY / AUDIT_SIGNING_KEY / JWT_PRIVATE_KEY_PEM,
# PUBLIC_BASE_URL not https, FileNet over plain http without ALLOW_INSECURE_FILENET=true, OIDC_ALLOW_HTTP=true.
# Production keys: `npm run gen-keys -- --production` (adds JWT_PRIVATE_KEY_PEM and MFA_ENC_KEY).
TF_ENV=development
# Reverse proxies in front of the API (Express 'trust proxy'): number of hops (1 = the OpenShift router), true/false,
# or a list of addresses/CIDRs. Used for client IPs in the audit log, rate limits and the staff network allowlist.
TRUST_PROXY=1
# Only to accept a plain-http FileNet GraphQL endpoint in production (e.g. an isolated TechZone test system).
ALLOW_INSECURE_FILENET=false
# Graceful shutdown on SIGTERM: keep serving (with /ready = 503) for SHUTDOWN_DELAY_MS, then stop accepting connections and
# wait up to SHUTDOWN_TIMEOUT_MS for in-flight requests. OpenShift uses 5000 / 25000 with terminationGracePeriodSeconds 45.
SHUTDOWN_DELAY_MS=0
SHUTDOWN_TIMEOUT_MS=20000
# Where verify:filenet / filenet-introspect write evidence reports (default docs/evidence; the container uses /data/evidence).
# TF_EVIDENCE_DIR=
# Build identity shown by GET /api/v1/version (set by the container build; leave empty locally).
# TF_VERSION=
# TF_COMMIT=
# TF_BUILD_TIME=
# `npm run entity:create` only: first administrator password (min 12 characters). Unset → a one-time password is printed once.
# Prefer passing it in the command's environment instead of keeping it here.
# TF_ENTITY_ADMIN_PASSWORD=

# --- Low-code Process Studio (docs/LOW-CODE-STUDIO.md) ---
# LOWCODE_AUTOMATION_MS=5000        # how often event/schedule rules run
# LOWCODE_WEBHOOK_MS=10000          # how often queued webhook deliveries are sent
# LOWCODE_WEBHOOK_TIMEOUT_MS=8000
# LOWCODE_WEBHOOK_ALLOW_HTTP=false  # http:// targets (never in TF_ENV=production)
# LOWCODE_WEBHOOK_ALLOW_PRIVATE=false # private/loopback targets (tests only; never in production)
