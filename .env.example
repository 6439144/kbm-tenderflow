# ==========================================
# TenderFlow v0.9.0 - Environment Configuration
# ==========================================
# NOTE: DO NOT COMMIT REAL SECRETS TO REPOSITORY.
# Replace placeholders with environment-specific values at runtime.

# Application Environment
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://tenderflow_user:tenderflow_pass@localhost:5432/tenderflow_db

# Identity & Access Management (Keycloak OIDC)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=tenderflow
KEYCLOAK_CLIENT_ID=tenderflow-api
KEYCLOAK_CLIENT_SECRET=change_me_client_secret
JWT_SECRET=change_me_jwt_secret_for_local_dev

# Document Content Store Adapter
# Options: filesystem | filenet
CONTENT_STORE_TYPE=filesystem
CONTENT_STORE_FS_PATH=./data/content-store
CONTENT_GRAPHQL_URL=https://techzone-content-service.example.com/content-services-graphql/api
CONTENT_REPO_ID=OS01
CONTENT_STORE_USERNAME=content_admin
CONTENT_STORE_PASSWORD=change_me_content_password

# AI Advisory Agent Integration (watsonx Orchestrate ADK / SaaS)
AI_SERVICE_URL=https://orchestrate.techzone.example.com/v1
AI_SERVICE_API_KEY=change_me_ai_key
AI_ENVIRONMENT_ID=dev-env-01

# Notifications (Mailpit Sandbox)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@tenderflow.local

# Security & Sealed Bid Master Encryption Key (Used for envelope encryption)
SEALED_BID_MASTER_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
AUDIT_SIGNING_KEY=change_me_audit_hmac_secret
