{
  "name": "tenderflow",
  "version": "0.9.0",
  "description": "Enterprise Digital Tendering Platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "ts-node tests/e2e/review-demo.test.ts",
    "test:security": "ts-node tests/security/sealed-bid-security.test.ts",
    "test:evals": "node agents/evals/score-evals.js",
    "scan:secrets": "node scripts/secret-scan.js",
    "generate:sbom": "node scripts/generate-sbom.js",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:api": "npm run dev --workspace=services/api",
    "dev:content": "npm run dev --workspace=services/content-adapter",
    "dev:vendor": "npm run dev --workspace=apps/vendor-portal",
    "dev:procurement": "npm run dev --workspace=apps/procurement-app",
    "dev:control": "npm run dev --workspace=apps/control-panel",
    "seed": "node seed/seed.js"
  },
  "keywords": [
    "tendering",
    "procurement",
    "sealed-bids",
    "multi-tenant",
    "watsonx",
    "filenet"
  ],
  "author": "Khorafi Business Machines (KBM)",
  "license": "UNLICENSED",
  "devDependencies": {
    "ts-node": "^10.9.2"
  }
}
