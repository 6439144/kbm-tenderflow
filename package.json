{
  "name": "tenderflow",
  "version": "1.0.0-rc1",
  "description": "Enterprise Digital Tendering Platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "services/api",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build -w apps/web && npm run build -w services/api",
    "start": "npm start -w services/api",
    "dev": "npm run dev -w services/api",
    "test": "npm test -w services/api",
    "gen-keys": "node scripts/gen-keys.mjs",
    "verify:filenet": "node services/api/dist/tools/verify-filenet.js",
    "verify:ai": "node services/api/dist/tools/verify-ai.js",
    "evals": "node services/api/dist/tools/run-evals.js",
    "demo:reset": "node scripts/demo-reset.mjs"
  },
  "keywords": [
    "tendering",
    "procurement",
    "sealed-bids",
    "multi-tenant",
    "watsonx",
    "filenet"
  ],
  "author": "Khorafi Business Machines (KBM)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  }
}
