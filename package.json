{
  "name": "tenderflow",
  "version": "0.9.0",
  "description": "Enterprise Digital Tendering Platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:api": "npm run dev --workspace=services/api",
    "dev:content": "npm run dev --workspace=services/content-adapter",
    "dev:vendor": "npm run dev --workspace=apps/vendor-portal",
    "dev:procurement": "npm run dev --workspace=apps/procurement-app",
    "dev:control": "npm run dev --workspace=apps/control-panel"
  },
  "keywords": [
    "tendering",
    "procurement",
    "sealed-bids",
    "multi-tenant",
    "watsonx",
    "filenet"
  ],
  "author": "Khorafi Business Machines (KBM)",
  "license": "UNLICENSED"
}
